---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/assets/img/animoji.png',
  noindex = false,
} = Astro.props;

// 404 has no real URL, so it gets no canonical -- pointing one at /404/ would
// advertise a route that does not exist and make a soft-404 indexable.
const canonical = noindex ? null : new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
const here = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? here === '/' : here.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Balaji Chidambaram" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/assets/img/icon.jpg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Balaji Chidambaram — Writing" href="/rss.xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="pf-nav">
      <nav class="container" aria-label="Primary">
        <a class="brand" href="/">Balaji</a>
        <ul>
          {nav.map((i) => (
            <li>
              <a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <footer class="pf-footer">
      <div class="container">
        <p>© 2026 Balaji Chidambaram</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: var(--container);
    padding: 0.5rem 0.9rem;
    border-radius: 6px;
  }
  .pf-nav nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.1rem 0;
    flex-wrap: wrap;
  }
  .pf-nav .brand {
    font-weight: 650;
    color: var(--violet);
    text-decoration: none;
    margin-right: auto;
    font-size: 1.05rem;
  }
  .pf-nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pf-nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .pf-nav a:hover {
    color: var(--violet);
  }
  .pf-nav a[aria-current='page'] {
    color: var(--violet);
    font-weight: 600;
  }
  .pf-footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding: 1.5rem 0;
    color: var(--text-light);
    font-size: 0.9rem;
  }
  .pf-footer p {
    margin: 0;
  }
</style>
